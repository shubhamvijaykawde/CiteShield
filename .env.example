# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- LLM provider -------------------------------------------------------------
# "anthropic" (default) or "ollama". Nothing switches provider implicitly.
# CITESHIELD_LLM__PROVIDER=anthropic

# Anthropic (paid API). Only needed when the provider is "anthropic".
ANTHROPIC_API_KEY=

# Ollama (local, free). Used for every LLM call when the provider is "ollama":
# guard, research tool loop, draft and repair. The Anthropic client is never created.
# CITESHIELD_LLM__PROVIDER=ollama
# CITESHIELD_LLM__OLLAMA_BASE_URL=http://localhost:11434
# CITESHIELD_LLM__OLLAMA_MODEL=qwen3:4b
# CITESHIELD_LLM__OLLAMA_NUM_CTX=16384      # Ollama's own default (4096) truncates silently
# CITESHIELD_LLM__OLLAMA_NUM_PREDICT=8192   # includes thinking tokens; 4096 truncated drafts
# CITESHIELD_LLM__OLLAMA_THINK=true

# --- Docker Compose only (compose.yaml; it always uses the Ollama provider) ---
# CITESHIELD_PORT=8000                                          # host port, bound to 127.0.0.1
# CITESHIELD_DOCKER_OLLAMA_URL=http://host.docker.internal:11434  # or http://ollama:11434 (--profile ollama)

# --- Other optional overrides (nested settings use a double underscore) -------
# CITESHIELD_AGENT__AGENT_EFFORT=medium
# CITESHIELD_AGENT__MAX_TOOL_ROUNDS=6
# CITESHIELD_QDRANT_URL=http://localhost:6333

# --- Verifier (milestone 5) ---------------------------------------------------
# CITESHIELD_VERIFIER__DEVICE=cpu            # cuda is ~18x faster but shares the 8 GB GPU
# CITESHIELD_VERIFIER__ENTAIL_THRESHOLD=0.51
# CITESHIELD_VERIFIER__CONTRADICTION_THRESHOLD=0.56
# CITESHIELD_VERIFIER__MIN_RETRIEVAL_SCORE=0.30
